{#
    Template: base.html.twig

    Template de layout base qui s'affiche sur toutes les pages, contient head/body

    Role:
        Afficher le code base de la page en HTML (doctype, head, metadata, css, javascript) et le block body

    Parameters:

#}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Voisin{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body>
{% include 'fragments/_header.html.twig' %}
<main class="container">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>
</body>
</html>
