{#
    Template: user/profile.html.twig
    Extends: base_html.twig

    Template pour afficher la page du profil de l'utilisateur

    Role:
        Afficher le page du profil de l'utilisateur

    Parameters:
        user - L'utilisateur a afficher

#}
{% extends 'base.html.twig' %}
{% block title %}{{ user.username }} – Voisin{% endblock %}
{% block body %}
<section class="profile-header">
    <img class="avatar-lg" src="{{ user.image ? asset('images/user/' ~ user.image) : asset('images/default-avatar.png') }}" alt="">
    <div>
        <h1>{{ user.username }}</h1>
        <p>{{ user.bio }}</p>
        <p class="muted">Membre depuis le {{ user.datetime|date('d/m/Y') }}</p>

        {% if isOwner %}
            <a class="btn btn-secondary" href="{{ path('app_user_edit', {id: user.id}) }}">Modifier mon profil</a>
        {% elseif isFriend %}
            <span class="badge">Ami(e)</span>
        {% else %}
            
            {% if isFriend %}
            <button class="btn btn-disabled" type="submit" disabled>Ami(e)</button>
            {% elseif isPending  %}
            <button class="btn btn-disabled" type="submit" disabled>Demande en attente</button>
            {% else %}
            <form action="{{ path('app_friend_request_send', {id: user.id}) }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('friend-request-' ~ user.id) }}">
            <button class="btn btn-primary" type="submit">Ajouter en ami</button>
            </form> 
            {% endif %}
            
        {% endif %}
    </div>
</section>

<section class="profile-friends">
    <h2>Amis ({{ user.friends|length }})</h2>
    <ul class="friend-chip-list">
        {% for friend in user.friends %}
            <li>
                <a href="{{ path('app_user_profile', {id: friend.id}) }}">
                    <img class="avatar-sm" src="{{ friend.image ? asset('images/user/' ~ friend.image) : asset('images/default-avatar.png') }}" alt="">
                    {{ friend.username }}
                </a>
            </li>
        {% else %}
            <li>Aucun ami pour le moment.</li>
        {% endfor %}
    </ul>
</section>

<section class="profile-posts">
    <h2>Publications</h2>
    <div class="post-grid">
        {% for post in posts %}
            <article class="post-card post-card-sm">
                <header>
                    <a class="post-author" href="{{ path('app_user_profile', {id: post.userId.id}) }}">
                        <img class="avatar" src="{{ post.userId.image ? asset('images/user/' ~ post.userId.image) : asset('images/default-avatar.png') }}" alt="">
                        <div class="post-meta">
                            <a href="{{ path('app_post_view', {id: post.id}) }}"><strong>{{ post.userId.username }}</strong></a>
                            <time>le {{ post.datetimeCreation|date('d/m/Y') }} à {{ post.datetimeCreation|date('H') }}h</time>
                        </div>
                    </a>
                    <span class="badge">{{ post.visibility ? 'Public' : 'Amis uniquement' }}</span>
                    {% if post.userId.id == app.user.id %}
                        <div class="header-actions">
                            <a href="{{ path('app_post_edit', {id: post.id}) }}">Modifier</a>
                            <form action="{{ path('app_post_delete', {id: post.id}) }}" method="post">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-post-' ~ post.id) }}">
                                <button class="link-button" type="submit" onclick="return confirm('Supprimer cette publication ?')">Supprimer</button>
                            </form>
                        </div>
                    {% endif %}
                </header>

                {% if post.image %}
                    <a href="{{ path('app_post_view', {id: post.id}) }}">
                        <img class="post-image" src="{{ asset('images/post/' ~ post.image) }}" alt="">
                    </a>
                {% endif %}
                {% if post.text %}<p class="post-text">{{ post.text }}</p>{% endif %}

                <div class="post-actions">
                    <form action="{{ path('app_post_like', {id: post.id}) }}" method="post">
                        <button type="submit" class="link-button">
                            {{ post.isLikedByUser(app.user) ? '💙' : '🤍' }} {{ post.likedBy|length }}
                        </button>
                    </form>
                    <a class="link-button" href="{{ path('app_post_view', {id: post.id}) }}">💬 {{ post.comments|length }}</a>
                </div>
            </article>
        {% else %}
            <p>Aucune publication visible.</p>
        {% endfor %}
    </div>
</section>
{% endblock %}
